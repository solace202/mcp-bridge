# Copy to .env and replace. Keys must be at least 16 characters.
MCP_ADMIN_KEY=replace-with-a-long-random-string
MCP_READONLY_KEY=replace-with-another-long-random-string
SHOP_API_TOKEN=replace-with-a-third-random-string
# local = read the shop database, rest = call the shop HTTP API
BRIDGE_BACKEND=local
# STREAMABLE (/mcp) or SSE (/sse + /mcp/message)
MCP_PROTOCOL=STREAMABLE
